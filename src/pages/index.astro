---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/omprakash.jpg';
import { SITE, STATS, SKILLS, EXPERIENCE } from '../consts';
import { latestPosts } from '../lib/wp';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const posts = await latestPosts(3);
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
	<section class="hero" style="padding-bottom:0">
		<div class="wrap">
			<div>
				<p class="hello">Hello<i>.</i></p>
				<p class="name">I’m Om</p>
				<h1 class="role">Lead Backend Engineer</h1>
				<p class="lede">
					Ten years building secure, multi-tenant enterprise software, and now the backends behind AI agents.
					Off the clock I build my own apps, run my own servers and write about both.
				</p>
				<div class="btn-row">
					<a class="btn btn-solid" href="#contact">Get in touch</a>
					<a class="btn btn-ghost" href="/resume/">My résumé</a>
				</div>
			</div>
			<div class="portrait">
				<Image src={portrait} alt="Omprakash Gautam, smiling, leaning on a railing by a lake" widths={[360, 540, 720]} sizes="(max-width: 820px) 78vw, 360px" format="webp" loading="eager" />
			</div>
		</div>
		<div class="ticker">
			<ul aria-label="Main technologies">
				{SKILLS.map((s) => <li>{s}</li>)}
			</ul>
		</div>
	</section>

	<section id="about">
		<div class="wrap about">
			<div>
				<h2>Career</h2>
				<ol class="timeline">
					{EXPERIENCE.map((e) => (
						<li>
							<h3>{e.role}</h3>
							<div class="when">{e.org} · {e.period}</div>
							<p>{e.note}</p>
						</li>
					))}
				</ol>
			</div>
			<div>
				<h2>About me</h2>
				<p class="muted">
					I like systems that are secure, fast and easy to operate. At work that means search, event pipelines and API platforms,
					and leading the engineers who build them. Lately it also means giving AI agents the tools they need to be useful.
				</p>
				<p class="muted">
					Outside work I build the OneLifeStack apps, run a small homelab and a VPS, and share what I learn on my blog.
					I’m based in Pune, India.
				</p>
				<div class="stats">
					{STATS.map((s) => (
						<div class="stat"><b>{s.value}<span>{s.suffix}</span></b><small>{s.label}</small></div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section id="work" style="background:var(--bg-2)">
		<div class="wrap">
			<h2 class="sec-title">Selected work</h2>
			<div class="work-list">
				{work.map((w) => (
					<article class="work-row">
						<div class="work-media">
							<div class="big">{w.data.highlight.value}</div>
							<div class="cap">{w.data.highlight.caption}</div>
						</div>
						<div>
							<h3>{w.data.title}</h3>
							<ul class="chips">{w.data.tags.map((t) => <li>{t}</li>)}</ul>
							<p class="muted">{w.data.summary}</p>
							<a class="textlink" href={`/work/${w.id}/`}>Read the case study</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	{posts.length > 0 && (
		<section id="writing">
			<div class="wrap">
				<h2 class="sec-title">Latest writing</h2>
				<div class="posts">
					{posts.map((p) => (
						<a class="post" href={p.link}>
							<time datetime={p.date}>{fmt(p.date)}</time>
							<h3>{p.title}</h3>
							<p>{p.excerpt}</p>
						</a>
					))}
				</div>
				<p class="center"><a class="textlink" href={SITE.blogUrl}>Read the blog</a></p>
			</div>
		</section>
	)}

	<section id="contact" style="background:var(--bg-2)">
		<div class="wrap contact">
			<div>
				<div class="kicker">Contact</div>
				<h2>Let’s talk.</h2>
				<p class="muted">Hiring, a collaboration, or a question about something I wrote? Send a note, or email me directly.</p>
				<p><a class="textlink" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
			</div>
			<form action={SITE.formAction} method="POST">
				<label>Name<input name="name" autocomplete="name" required /></label>
				<label>Email<input name="email" type="email" autocomplete="email" required /></label>
				<label>Message<textarea name="message" required></textarea></label>
				<input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<div><button class="btn btn-solid" type="submit">Send message</button></div>
				<p class="form-note">I read every message and reply from my own inbox.</p>
			</form>
		</div>
	</section>
</Base>
