---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title} · Omprakash Gautam`} description={d.summary}>
	<article class="prose">
		<a class="back" href="/#work">← All work</a>
		<h1>{d.title}</h1>
		<ul class="chips">{d.tags.map((t) => <li>{t}</li>)}</ul>
		<p class="muted">Role: {d.role}</p>
		<Content />
		{d.link && <p><a class="textlink" href={d.link.href}>{d.link.label}</a></p>}
	</article>
</Base>
